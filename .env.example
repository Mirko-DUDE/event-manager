# Copiare in `.env` (non committato) e valorizzare con i valori reali.
# DATABASE_URL: MongoDB locale in sviluppo (Community Server su localhost:27017).
# In produzione: MongoDB Atlas (cluster M0, connection string mongodb+srv://...) — vedi fase-3-deploy.md § 3.1;
# il valore reale va in Secret Manager (`DATABASE_URL`), mai in questo file.
DATABASE_URL=mongodb://127.0.0.1:27017/event-manager
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Seed super-admin di bootstrap (pnpm seed:super-admin) — dev e deploy; non committare valori reali
SEED_SUPER_ADMIN_EMAIL=admin@example.com
SEED_SUPER_ADMIN_PASSWORD=ChangeMe1!

# Google OAuth 2.0 (Fase 2 § 2.3) — da Google Cloud Console; non committare valori reali
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret

# Resend (Fase 2 § 2.6) — attivazione utente e reset password; non committare valori reali
RESEND_API_KEY=re_your-api-key
# Non segreta: in produzione è env var normale su Cloud Run (non Secret Manager).
# Valore di produzione ancora da confermare (stesso di sviluppo o diverso) — vedi fase-3-deploy.md § 3.2.
RESEND_FROM_ADDRESS=noreply@your-verified-domain.com
RESEND_FROM_NAME=Event Manager

# URL pubblico dell'app (senza trailing slash) — unica variabile per OAuth, Payload e link email.
# Locale: http://localhost:3000. In produzione: valorizzare dopo che Cloud Run assegna l'URL (§ 3.3).
# Non è una NEXT_PUBLIC_* (non serve al client; evita inline a build-time).
SERVER_URL=http://localhost:3000
# Solo whitelist CSRF Payload (login locale via URL nativo Cloud Run). Non usato per OAuth/email/link.
# In produzione: https://event-manager-757912956991.europe-west1.run.app — vedi CHANGELOG [Unreleased].
CLOUD_RUN_URL=

# HubSpot Service Key (Fase 4 § 2.7) — sync unidirezionale contatti, scope crm.objects.contacts.read.
# Non committare il valore reale: in locale va in `.env`; in produzione in Secret Manager (`HUBSPOT_ACCESS_TOKEN`).
# Non va in hubspotSyncConfig né in apiCredentials (credenziale verso terzo, non config Admin).
HUBSPOT_ACCESS_TOKEN=

# NODE_ENV: non impostare a mano. `next build` / `next start` (e l'immagine Docker di produzione)
# impostano già `production`; in `pnpm dev` Next usa `development`. Cloud Run non richiede un override.
