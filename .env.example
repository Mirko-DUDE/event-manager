# Copiare in `.env` (non committato) e valorizzare con i valori reali.
# DATABASE_URL: MongoDB locale in sviluppo (Community Server su localhost:27017)
DATABASE_URL=mongodb://127.0.0.1:27017/event-manager
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Seed super-admin di bootstrap (pnpm seed:super-admin) — dev e deploy; non committare valori reali
SEED_SUPER_ADMIN_EMAIL=admin@example.com
SEED_SUPER_ADMIN_PASSWORD=ChangeMe1!

# Google OAuth 2.0 (Fase 2 § 2.3) — da Google Cloud Console; non committare valori reali
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret

# URL pubblico dell'app (senza trailing slash) — per redirect OAuth; default http://localhost:3000
# NEXT_PUBLIC_SERVER_URL=http://localhost:3000
